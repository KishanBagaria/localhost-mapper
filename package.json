{
  "name": "localhost-mapper",
  "version": "0.2.0",
  "description": "Run your dev servers on addresses like https://awesome-site/ or https://🍔/ instead of localhost",
  "license": "MIT",
  "repository": "KishanBagaria/localhost-mapper",
  "author": {
    "name": "Kishan Bagaria",
    "url": "https://kishan.org"
  },
  "keywords": [
    "pac",
    "proxyautoconfig",
    "networksetup",
    "hotel",
    "proxy",
    "dev",
    "devtool",
    "domain",
    "host",
    "https",
    "local",
    "localhost",
    "process",
    "mapper",
    "server"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "localhost-mapper": "./dist/bin.js",
    "lh-map": "./dist/bin.js"
  },
  "files": [
    "dist",
    "vendor"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "lint": "biome check .",
    "format": "biome check --write .",
    "pretypecheck": "npm run build",
    "typecheck": "tsc -p tsconfig.test.json",
    "pretest": "npm run lint && npm run typecheck",
    "test": "ava test/unit",
    "test:integration": "npm run build && ava test/integration",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "boxen": "^8.0.1",
    "chalk": "^6.0.0",
    "execa": "^10.0.0",
    "exit-hook": "^5.1.0",
    "get-port": "^7.2.0",
    "http-proxy-3": "^1.23.3",
    "open": "^11.0.0",
    "selfsigned": "^5.5.0",
    "update-notifier": "^7.3.1",
    "winreg": "^1.2.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^26.1.2",
    "@types/update-notifier": "^6.0.8",
    "@types/winreg": "^1.2.36",
    "ava": "^8.0.1",
    "puppeteer": "^25.4.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "ava": {
    "failFast": true,
    "extensions": [
      "ts",
      "js"
    ],
    "nodeArguments": [
      "--import=tsx"
    ]
  }
}
